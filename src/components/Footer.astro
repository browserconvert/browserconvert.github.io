---
import { languages, type SupportedLanguage, getLocalizedPath, useTranslations } from '../i18n/ui';
import { Heart, Layers, ShieldCheck } from 'lucide-react';

interface Props {
  currentLang: SupportedLanguage;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
---

<footer class="w-full border-t border-silver dark:border-obsidian-border bg-alabaster dark:bg-obsidian-box py-12 px-4 sm:px-6 lg:px-8 transition-colors">
  <div class="max-w-6xl mx-auto flex flex-col items-center">
    
    {/* Brand & Mission */}
    <div class="flex flex-col items-center text-center mb-8">
      <div class="flex items-center gap-2.5 mb-2">
        <div class="w-8 h-8 rounded-xl bg-ruby flex items-center justify-center text-white shadow-ruby-sm">
          <Layers class="w-5 h-5" />
        </div>
        <span class="text-xl font-black text-obsidian dark:text-white">
          Browser<span class="text-ruby">Convert</span>
        </span>
      </div>
      <p class="text-xs text-neutral-500 max-w-md">
        {t('tagline')} — 100% client-side privacy, running WebAssembly in browser RAM. Zero server uploads.
      </p>
    </div>

    {/* Language Switcher Strip */}
    <div class="flex flex-wrap justify-center gap-2 mb-8 max-w-xl text-xs">
      {(Object.keys(languages) as SupportedLanguage[]).map((langKey) => (
        <a
          href={getLocalizedPath(currentLang, langKey)}
          class={`px-3 py-1.5 rounded-xl border transition-colors ${
            langKey === currentLang
              ? 'bg-ruby text-white font-bold border-ruby shadow-ruby-sm'
              : 'border-silver dark:border-obsidian-border bg-white dark:bg-obsidian text-neutral-600 dark:text-neutral-300 hover:border-ruby'
          }`}
        >
          {languages[langKey]}
        </a>
      ))}
    </div>

    {/* Links and Actions */}
    <div class="flex flex-wrap items-center justify-center gap-6 mb-8 text-sm font-semibold">
      <a
        href="https://kisharadilshan.gumroad.com/coffee"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-ruby text-white hover:bg-ruby-hover shadow-ruby-sm transition-all"
      >
        <Heart class="w-4 h-4 fill-white" />
        <span>{t('supportDev')}</span>
      </a>

      <a
        href="https://github.com/browserconvert/browserconvert.github.io"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-silver dark:border-obsidian-border bg-white dark:bg-obsidian text-obsidian dark:text-white hover:border-ruby transition-colors"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub</span>
      </a>
    </div>

    {/* Bottom Copyright & Privacy Seal */}
    <div class="flex flex-col sm:flex-row items-center justify-between w-full pt-8 border-t border-silver dark:border-obsidian-border text-xs text-neutral-500 gap-4">
      <div class="flex items-center gap-1.5">
        <ShieldCheck class="w-4 h-4 text-emerald-500" />
        <span>Zero Server Uploads • Unlimited Local RAM Conversion</span>
      </div>
      <div>
        © {new Date().getFullYear()} BrowserConvert. Open source under MIT License.
      </div>
    </div>

  </div>
</footer>
